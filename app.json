{
  "expo": {
    "name": "Pourify",
    "slug": "Pourify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pourify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pourify",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to scan delivery notes."
      }
    },
    "android": {
      "package": "com.pourify",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Roobert-Bold.otf",
            "./assets/fonts/Roobert-BoldItalic.otf",
            "./assets/fonts/Roobert-Heavy.otf",
            "./assets/fonts/Roobert-HeavyItalic.otf",
            "./assets/fonts/Roobert-Light.otf",
            "./assets/fonts/Roobert-LightItalic.otf",
            "./assets/fonts/Roobert-Medium.otf"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
